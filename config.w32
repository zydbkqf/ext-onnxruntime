// vim:ft=javascript
//
// Windows build configuration for the ONNX Runtime PHP extension.
//
// This file is intentionally separate from config.m4: PHP on Windows uses
// the php-sdk build system (buildconf/configure/nmake), not autoconf/phpize.
//
// Required configure option:
//   --with-onnxruntime=DIR   ORT SDK root containing include\ and lib\
//
// The SDK must be x64 and must contain onnxruntime.lib.  GPU provider DLLs
// are runtime dependencies and are not linked into the PHP extension.

// PHP's Windows build puts the sources from src/ into $(BUILD_DIR)\src in the
// linker object list, but its default compiler rule writes all objects into
// $(BUILD_DIR) itself.  Create the directory and redirect the compiler's /Fo
// output so a clean php-sdk/php-windows-builder run does not fail with LNK1181.
var build_dir = get_define("BUILD_DIR");
if (build_dir) {
	var abs_build_dir = FSO.GetAbsolutePathName(build_dir);
	var build_parent = FSO.GetParentFolderName(abs_build_dir);
	if (!FSO.FolderExists(build_parent)) {
		FSO.CreateFolder(build_parent);
	}
	if (!FSO.FolderExists(abs_build_dir)) {
		FSO.CreateFolder(abs_build_dir);
	}
	if (!FSO.FolderExists(abs_build_dir + "\\src")) {
		FSO.CreateFolder(abs_build_dir + "\\src");
	}
}

ARG_WITH("onnxruntime", "ONNX Runtime support", "no");

if (PHP_ONNXRUNTIME == "no") {
	ERROR("--with-onnxruntime=DIR is required (DIR contains include\\ and lib\\).");
}

if (PHP_ONNXRUNTIME == "yes") {
	ERROR("--with-onnxruntime requires a directory, for example --with-onnxruntime=E:\\ort\\onnxruntime-win-x64-1.28.2");
}

var ort_root = PHP_ONNXRUNTIME;
var ort_include = ort_root + "\\include";
var ort_lib = ort_root + "\\lib";

if (!FSO.FolderExists(ort_root)) {
	ERROR("ONNX Runtime SDK directory does not exist: " + ort_root);
}
if (!FSO.FileExists(ort_include + "\\onnxruntime_cxx_api.h")) {
	ERROR("onnxruntime_cxx_api.h not found in " + ort_include);
}
if (!FSO.FileExists(ort_lib + "\\onnxruntime.lib")) {
	ERROR("onnxruntime.lib not found in " + ort_lib);
}

// Read the API version so the module can refuse an older runtime at startup
// and report the right version in phpinfo().
var ort_header = FSO.OpenTextFile(ort_include + "\\onnxruntime_c_api.h", 1);
var ort_header_text = ort_header.ReadAll();
ort_header.Close();
var ort_api_match = ort_header_text.match(/#define[ \t]+ORT_API_VERSION[ \t]+([0-9]+)/);
if (!ort_api_match) {
	ERROR("could not read ORT_API_VERSION from " + ort_include + "\\onnxruntime_c_api.h");
}
var ort_api_version = parseInt(ort_api_match[1], 10);
if (ort_api_version < 23) {
	ERROR("ONNX Runtime API version " + ort_api_version + " is too old; 1.18 or newer is required. EP-device features need 1.23+.");
}

var ort_version = "unknown";
if (FSO.FileExists(ort_root + "\\VERSION_NUMBER")) {
	var version_file = FSO.OpenTextFile(ort_root + "\\VERSION_NUMBER", 1);
	ort_version = version_file.ReadAll().replace(/[\r\n]+$/, "");
	version_file.Close();
}

ADD_FLAG("LDFLAGS_ONNXRUNTIME", "/LIBPATH:\"" + ort_lib + "\"");
ADD_FLAG("LIBS_ONNXRUNTIME", "onnxruntime.lib");
ADD_FLAG("CFLAGS_BD_", "/Fo$(BUILD_DIR)\\src\\");

EXTENSION("onnxruntime",
	"src/onnxruntime.cpp src/onnx_tensor.cpp src/zval_converter.cpp " +
	"src/ort_value_converter.cpp src/ort_environment.cpp src/session.cpp " +
	"src/session_options.cpp src/runtime.cpp src/ep_device.cpp " +
	"src/async_engine.cpp src/device_tensor.cpp src/io_binding.cpp",
	PHP_ONNXRUNTIME_SHARED,
	"/std:c++17 /EHsc /I \"" + ort_include + "\" " +
	"/DNOMINMAX /DZEND_ENABLE_STATIC_TSRMLS_CACHE=1");

AC_DEFINE("HAVE_ONNXRUNTIME", 1,
	"Define to 1 if the ONNX Runtime extension is available.");
AC_DEFINE("PHP_ORT_BUILD_API_VERSION", ort_api_version,
	"ORT_API_VERSION used for the build.");
AC_DEFINE("PHP_ORT_ORT_VERSION", '"' + ort_version + '"',
	"ONNX Runtime version used for the build.");
AC_DEFINE("PHP_ORT_SOURCE", '"dir"',
	"Where the ONNX Runtime SDK came from.");
