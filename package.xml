  <release>0.4.5</release>
  <api>0.4.0</api>
 </version>
 <stability>
  <release>beta</release>
  <api>beta</api>
 </stability>
 <license uri="https://opensource.org/licenses/MIT">MIT</license>
 <notes>Phase 7C/7D device tensors and explicit device copies, plus Phase 7F async I/O Binding on the native Task engine. Includes Phase 7A CPU I/O Binding, Phase 7B fixed-shape preallocated output and Phase 7E explicit batch inference.</notes>
