 <name>onnxruntime</name>
 <channel>pecl.php.net</channel>
 <summary>PHP bindings for ONNX Runtime synchronous inference</summary>
 <description>Zend C++ extension for loading ONNX models and running synchronous inference without FFI or Python.</description>
 <lead>
  <name>Denis Cheung</name>
  <user>denischeung</user>
  <email>denischeung@users.noreply.github.com</email>
  <active>yes</active>
 </lead>
